# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local browser-test artefacts
.playwright-mcp/

# Figma frame exports (large source renders for scripts/crop-*.py)
design/

# admin content store and lead capture (local development only)
/.content-store.json
/.content-draft.json
/.content-history/
/.leads.jsonl
/public/uploads/
!.env.example

# design hook cache
/.impeccable/
