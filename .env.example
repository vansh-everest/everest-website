# Admin panel. With none of these set, /admin refuses every sign in.
SESSION_SECRET=
ADMIN_EMAIL=admin
ADMIN_PASSWORD=
VIEWER_EMAIL=viewer
VIEWER_PASSWORD=

# Content and image storage in production. Without both, /admin is read only.
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE_URL=

# Optional. Forwards each lead to a CRM as JSON.
LEAD_WEBHOOK_URL=
