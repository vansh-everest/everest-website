# Admin panel. With none of these set, /admin refuses every sign in.
SESSION_SECRET=
ADMIN_EMAIL=admin
ADMIN_PASSWORD=
VIEWER_EMAIL=viewer
VIEWER_PASSWORD=

# Admin content (drafts, the live copy, history): a PRIVATE Vercel Blob store connected to
# production and preview with the prefix CONTENT_BLOB. Without it, /admin is read only.
CONTENT_BLOB_READ_WRITE_TOKEN=

# Images uploaded in /admin: a PUBLIC Vercel Blob store (default prefix BLOB).
BLOB_READ_WRITE_TOKEN=

# Optional. Forwards each lead to a CRM as JSON.
LEAD_WEBHOOK_URL=

# ---- Everest's own systems (replace everything above once set; all optional until then) ----
# Public pages read published content through fleet_connect, and forms hand leads to it.
FLEET_CONNECT_URL=          # https://leads-api.everestfleet.com
FLEET_CONNECT_KEY=          # same value as fleet_connect's WEBSITE_API_KEY
# The admin edits through Jarvis and signs people in with their Hawkeye session.
# It must then run on an everestfleet.com address (website-admin.everestfleet.com).
JARVIS_API_URL=             # https://api.everestfleet.com
HAWKEYE_URL=                # https://hawkeye.everestfleet.com
# Google Analytics 4 measurement id; the tag only loads when this is set.
NEXT_PUBLIC_GA_ID=          # G-XXXXXXXXXX
