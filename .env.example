# Admin panel. With none of these set, /admin refuses every sign in.
SESSION_SECRET=
ADMIN_EMAIL=admin
ADMIN_PASSWORD=
VIEWER_EMAIL=viewer
VIEWER_PASSWORD=

# Admin content (drafts, the live copy, history): a PRIVATE Vercel Blob store connected to
# production and preview with the prefix CONTENT_BLOB. Without it, /admin is read only.
CONTENT_BLOB_READ_WRITE_TOKEN=

# Images uploaded in /admin: a PUBLIC Vercel Blob store (default prefix BLOB).
BLOB_READ_WRITE_TOKEN=

# Optional. Forwards each lead to a CRM as JSON.
LEAD_WEBHOOK_URL=
